---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Timeline from '../components/Timeline.astro';
import Projects from '../components/Projects.astro';
import Tools from '../components/Tools.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const title = 'Carlotta Della Casa | Junior Content Creator & Social Media Assistant a Modena';
const description = 'Portfolio di Carlotta Della Casa, candidata junior per agenzie di comunicazione a Modena. Concept social, contenuti grafici e un approccio che unisce metodo, colore e comunicazione.';
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <Hero />
    <About />
    <Skills />
    <Timeline />
    <Projects />
    <Tools />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
