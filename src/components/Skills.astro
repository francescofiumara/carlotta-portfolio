---
import SectionTitle from './SectionTitle.astro';
import SkillCard from './SkillCard.astro';

const skills = [
  {
    title: 'Metodo',
    text: 'Organizzo il lavoro, seguo i passaggi con attenzione e rispetto le scadenze.',
    tone: 'coral',
  },
  {
    title: 'Sensibilità visiva',
    text: 'L’esperienza con colori, superfici e grafiche mi ha allenata a osservare armonie, contrasti e coerenza.',
    tone: 'apricot',
  },
  {
    title: 'Creatività concreta',
    text: 'Mi interessa trovare idee che possano essere realmente utilizzate, adattandole al tono e alle esigenze di ogni realtà.',
    tone: 'lilac',
  },
  {
    title: 'Collaborazione',
    text: 'Ascolto, accolgo i feedback e affronto le revisioni come parte naturale del lavoro creativo.',
    tone: 'sage',
  },
] as const;
---

<section id="competenze" class="section">
  <div class="container-page">
    <SectionTitle
      eyebrow="Cosa porto con me"
      title="Un approccio concreto al lavoro creativo"
      text="Metodo, sensibilità visiva e disponibilità al confronto sono il punto di partenza con cui affronto ogni contenuto."
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {skills.map((skill) => <SkillCard {...skill} />)}
    </div>
  </div>
</section>
