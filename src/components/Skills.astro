---
import SectionTitle from './SectionTitle.astro';
import SkillCard from './SkillCard.astro';

const skills = [
  {
    title: 'Metodo operativo',
    text: 'Arrivo da un contesto in cui processi, controlli e scadenze contano: porto questa attenzione anche nell’organizzazione dei contenuti.',
    tone: 'coral',
  },
  {
    title: 'Occhio estetico',
    text: 'Colori, superfici e grafiche mi hanno allenata a osservare armonie, contrasti e coerenza: dettagli che rendono riconoscibile un contenuto.',
    tone: 'apricot',
  },
  {
    title: 'Idee applicabili',
    text: 'Nei miei concept parto da un obiettivo e da un pubblico preciso, per trasformare un’idea in format, copy e contenuti utilizzabili.',
    tone: 'lilac',
  },
  {
    title: 'Ascolto e confronto',
    text: 'Sono abituata a lavorare con precisione e ad accogliere indicazioni e revisioni: per me il confronto è parte del risultato.',
    tone: 'sage',
  },
] as const;
---

<section id="competenze" class="section">
  <div class="container-page">
    <SectionTitle
      eyebrow="Cosa porto con me"
      title="Le basi che porto in un team"
      text="Non sostituiscono l’esperienza in agenzia: sono il punto di partenza concreto con cui voglio imparare e contribuire ai progetti del team."
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {skills.map((skill) => <SkillCard {...skill} />)}
    </div>
  </div>
</section>
