---
interface Props {
  index: number;
  featured: boolean;
  name: string;
  type: string;
  label: string;
  description: string;
  context: string;
  objective: string;
  audience: string;
  hypothesis: string;
  direction: string;
  pillars: readonly (readonly [string, string?])[];
  channels?: readonly (readonly [string, string])[];
  outputs: readonly string[];
  criteria: string;
  demonstrates: string;
  palette: readonly string[];
  mood: readonly string[];
  posts: readonly string[];
  carousel: readonly string[];
  captions: readonly string[];
  calendar: readonly string[];
}

const { index, featured, name, type, label, description, context, objective, audience, hypothesis, direction, pillars, channels, outputs, criteria, demonstrates, palette, mood, posts, carousel, captions, calendar } = Astro.props;
const panelId = `project-${index}-content`;
---

<article class:list={['project-card', { 'project-card--featured': featured }]}>
  <div class="project-preview">
    <div class="project-preview__copy">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <p class="eyebrow">{type}</p>
        <span class="project-label">{label}</span>
      </div>
      <h3 class="mt-5 font-display text-3xl font-bold leading-tight sm:text-4xl">{name}</h3>
      <p class="mt-4 max-w-prose text-base leading-7 text-muted dark:text-nighttext/80">{description}</p>
      <button class="project-trigger" type="button" aria-expanded="false" aria-controls={panelId} data-project-trigger>
        <span data-open-label>Esplora il progetto</span>
        <span data-close-label hidden>Chiudi il progetto</span>
        <span class="project-trigger__icon" aria-hidden="true">↗</span>
      </button>
    </div>
    <div class="project-preview__visual" aria-label={`Anteprima feed del concept ${name}`}>
      <div class="project-feed">
        {posts.map((post, tileIndex) => (
          <div class="project-feed__tile" style={`background-color: ${palette[tileIndex % palette.length]}`}>
            <span>{post}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

    <div id={panelId} class="project-case-study" hidden>
      <div class="project-story">
        <section><h4>Contesto</h4><p>{context}</p></section>
        <section><h4>Obiettivo</h4><p>{objective}</p></section>
        <section><h4>Pubblico</h4><p>{audience}</p></section>
        <section class="project-story__emphasis"><h4>Ipotesi strategica</h4><p>{hypothesis}</p></section>
        <section><h4>Direzione creativa</h4><p>{direction}</p></section>
      </div>

      <section class="project-case-study__section">
        <h4>Sistema di contenuti</h4>
        <ul class="project-pillars">
          {pillars.map(([title, text]) => <li><strong>{title}</strong>{text && <> — {text}</>}</li>)}
        </ul>
        {channels && <ul class="project-channels">{channels.map(([title, text]) => <li><strong>{title}</strong> — {text}</li>)}</ul>}
      </section>

      <section class="project-case-study__section">
        <h4>Output sviluppati</h4>
        <ul class="project-outputs">{outputs.map((item) => <li>{item}</li>)}</ul>
      </section>

      <section class="project-case-study__section">
        <h4>Esempi concept</h4>
        <div class="project-gallery">
          <div class="project-gallery__group">
            <h5>Palette</h5>
            <div class="project-palette" aria-label={`Palette cromatica di ${name}`}>
              {palette.map((color) => <span style={`background-color: ${color}`} aria-label={color}></span>)}
            </div>
          </div>
          <div class="project-gallery__group">
            <h5>Moodboard</h5>
            <ul class="project-mood">{mood.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="project-gallery__group project-gallery__group--wide">
            <h5>Anteprima feed</h5>
            <div class="project-feed project-feed--gallery" aria-label={`Anteprima feed del concept ${name}`}>
              {posts.map((post, tileIndex) => <div class="project-feed__tile" style={`background-color: ${palette[tileIndex % palette.length]}`}><span>{post}</span></div>)}
            </div>
          </div>
          <div class="project-gallery__group project-gallery__group--wide">
            <h5>Carosello</h5>
            <div class="project-carousel">
              {carousel.map((slide, slideIndex) => <div style={`background-color: ${palette[slideIndex]}`}><span>{slide}</span></div>)}
            </div>
          </div>
          <div class="project-gallery__group">
            <h5>Caption</h5>
            <ul class="project-captions">{captions.map((caption) => <li>“{caption}”</li>)}</ul>
          </div>
          <div class="project-gallery__group">
            <h5>Mini calendario</h5>
            <ul class="project-calendar">{calendar.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
      </section>

      <div class="project-story project-story--closing">
        <section><h4>Come valuterei il progetto</h4><p>{criteria}</p></section>
        <section><h4>Cosa dimostra il progetto</h4><p>{demonstrates}</p></section>
      </div>
    </div>
</article>
