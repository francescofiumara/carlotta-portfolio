---
interface Props {
  name: string; type: string; label: string; description: string; context: string; objective: string; audience: string; direction: string;
  strategy: readonly string[]; outputs: readonly string[]; criteria: string; demonstrates: string; palette: readonly string[]; mood: readonly string[];
  posts: readonly string[]; carousel: readonly string[]; captions: readonly string[]; calendar: readonly string[]; accent: string; why?: string;
}
const { name, type, label, description, context, objective, audience, direction, strategy, outputs, criteria, demonstrates, palette, mood, posts, carousel, captions, calendar, accent, why } = Astro.props;
---

<article class="card h-full overflow-hidden">
  <div class="flex h-full flex-col p-6 sm:p-7">
    <div class="flex flex-wrap items-center gap-2"><p class="text-sm font-bold text-coral">{type}</p><span class="rounded-full border border-ink/10 px-2.5 py-1 text-xs font-bold dark:border-white/15">{label}</span></div>
    <h3 class="mt-3 font-display text-2xl font-bold">{name}</h3>
    <p class="mt-3 leading-7 text-muted dark:text-nighttext/75">{description}</p>
    <details class="group mt-auto pt-6" data-project-details name="portfolio-projects">
      <summary class="button-primary cursor-pointer list-none [&::-webkit-details-marker]:hidden"><span class="group-open:hidden">Esplora il progetto</span><span class="hidden group-open:inline">Chiudi il progetto</span><span class="ml-2" aria-hidden="true">↓</span></summary>
      <div class="mt-7 border-t border-ink/10 pt-7 dark:border-white/10">
        <div class="grid gap-5 text-sm leading-6 text-muted dark:text-nighttext/75">
          <section><h4 class="font-display text-lg font-bold text-ink dark:text-nighttext">1. Contesto</h4><p class="mt-2">{context}</p></section><section><h4 class="font-display text-lg font-bold text-ink dark:text-nighttext">2. Obiettivo</h4><p class="mt-2">{objective}</p></section><section><h4 class="font-display text-lg font-bold text-ink dark:text-nighttext">3. Pubblico</h4><p class="mt-2">{audience}</p></section><section><h4 class="font-display text-lg font-bold text-ink dark:text-nighttext">4. Direzione creativa</h4><p class="mt-2">{direction}</p></section><section><h4 class="font-display text-lg font-bold text-ink dark:text-nighttext">5. Strategia dei contenuti</h4><div class="mt-3 flex flex-wrap gap-2">{strategy.map((item) => <span class="rounded-full bg-ink/[0.06] px-3 py-1.5 text-xs font-bold dark:bg-white/[0.08]">{item}</span>)}</div></section><section><h4 class="font-display text-lg font-bold text-ink dark:text-nighttext">6. Output sviluppati</h4><ul class="mt-3 grid gap-1.5">{outputs.map((item) => <li>• {item}</li>)}</ul></section>
        </div>
        <section class="mt-7 rounded-xl border border-ink/10 bg-white/60 p-4 dark:border-white/10 dark:bg-white/[0.04]" aria-label={`Anteprime statiche del concept ${name}`}>
          <div class="flex items-center justify-between gap-3"><h4 class="font-display text-lg font-bold">Output statici</h4><span class="text-xs font-bold text-muted dark:text-nighttext/70">Esempi concept</span></div>
          <div class="mt-4 grid gap-4 sm:grid-cols-2"><div><p class="text-xs font-bold uppercase tracking-wide text-muted dark:text-nighttext/70">Palette</p><div class="mt-2 flex overflow-hidden rounded-lg">{palette.map((color) => <span class="h-12 flex-1" style={`background-color: ${color}`}></span>)}</div></div><div><p class="text-xs font-bold uppercase tracking-wide text-muted dark:text-nighttext/70">Moodboard</p><div class="mt-2 flex flex-wrap gap-1.5">{mood.map((item) => <span class="rounded-md px-2 py-1 text-xs font-semibold text-white" style={`background-color: ${accent}`}>{item}</span>)}</div></div></div>
          <div class="mt-5"><p class="text-xs font-bold uppercase tracking-wide text-muted dark:text-nighttext/70">Anteprima feed</p><div class="mt-2 grid grid-cols-3 gap-2">{posts.map((post, index) => <div class="aspect-square rounded-md p-2 text-[10px] font-bold leading-tight text-white" style={`background-color: ${palette[index % palette.length]}; ${index === 3 ? 'color: #1f2937' : ''}`}><span class="block h-1.5 w-7 rounded-full bg-white/50"></span><span class="mt-5 block">{post}</span></div>)}</div></div>
          <div class="mt-5"><p class="text-xs font-bold uppercase tracking-wide text-muted dark:text-nighttext/70">Carosello</p><div class="mt-2 grid grid-cols-3 gap-2">{carousel.map((slide, index) => <div class="min-h-20 rounded-md p-2 text-xs font-bold leading-tight" style={`background-color: ${palette[index]}; color: ${index === 2 ? '#1f2937' : '#ffffff'}`}>{slide}</div>)}</div></div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2"><div><p class="text-xs font-bold uppercase tracking-wide text-muted dark:text-nighttext/70">Caption</p><ul class="mt-2 grid gap-2 text-xs leading-5 text-muted dark:text-nighttext/75">{captions.map((caption) => <li class="border-l-2 pl-2" style={`border-color: ${accent}`}>“{caption}”</li>)}</ul></div><div><p class="text-xs font-bold uppercase tracking-wide text-muted dark:text-nighttext/70">Mini calendario</p><div class="mt-2 grid grid-cols-2 gap-1.5">{calendar.map((item) => <span class="rounded-md bg-ink/[0.05] px-2 py-1.5 text-xs font-semibold dark:bg-white/[0.08]">{item}</span>)}</div></div></div>
        </section>
        <div class="mt-7 grid gap-5 text-sm leading-6 text-muted dark:text-nighttext/75"><section><h4 class="font-display text-lg font-bold text-ink dark:text-nighttext">7. Criteri di valutazione</h4><p class="mt-2">{criteria}</p></section><section><h4 class="font-display text-lg font-bold text-ink dark:text-nighttext">8. Cosa dimostra il progetto</h4><p class="mt-2">{demonstrates}</p></section>{why && <section class="rounded-lg bg-sage/20 p-4 dark:bg-sage/15"><h4 class="font-display text-lg font-bold text-ink dark:text-nighttext">Perché questo progetto mi rappresenta</h4><p class="mt-2">{why}</p></section>}</div>
      </div>
    </details>
  </div>
</article>
